[Desktop Entry]
Version=1.0
Type=Application
Name=Polyglot Studio
GenericName=Multi-Framework Transpiler & Deploy Exporter
Comment=Zero-Dependency Polyglot Framework Transpiler, Multi-Stack Component & Deploy Config Exporter
Exec=/usr/local/bin/polyglot desktop
Icon=polyglot
Terminal=false
Categories=Development;System;Utility;
StartupNotify=true
Actions=CLI;Web;

[Desktop Action CLI]
Name=Open Polyglot CLI
Exec=x-terminal-emulator -e "/usr/local/bin/polyglot --help"

[Desktop Action Web]
Name=Open Web UI (Port 8126)
Exec=/usr/local/bin/polyglot web
